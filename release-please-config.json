{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "packages": {
    "apps/desktop": {
      "release-type": "node",
      "package-name": "lirovo-desktop",
      "component": "",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": []
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Faster"
    },
    {
      "type": "refactor",
      "section": "Changed"
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Docs",
      "hidden": true
    }
  ]
}
