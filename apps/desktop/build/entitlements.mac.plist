<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The main application binary, and nothing else.

  electron-builder gives this file to the .app bundle alone; every other
  Mach-O it signs — the helpers AND the bundled tools in Resources/bin — gets
  entitlements.mac.inherit.plist instead. Keeping them as one file meant the
  most privileged process in the app carried entitlements that exist only so a
  PyInstaller binary can unpack itself.

  Compare with @electron/osx-sign, which gives the main app `allow-jit` and
  nothing more. This adds one key to that, and no others: no camera, no
  microphone, no address book, no user-selected files beyond the open panel
  the app already uses.
-->
<plist version="1.0">
<dict>
  <!-- V8 compiles JavaScript at runtime; the hardened runtime otherwise
       refuses and the app does not start. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Fetching a speech model, downloading a video, and reaching a model
       server on localhost. The app makes no inbound connections and needs no
       server entitlement. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
