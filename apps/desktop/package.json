{
  "name": "lirovo-desktop",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "collect:binaries": "node scripts/collect-binaries.mjs",
    "dist": "pnpm build && pnpm collect:binaries && electron-builder --mac --publish never",
    "dist:arm64": "pnpm build && node scripts/collect-binaries.mjs --arm64 && electron-builder --mac --arm64 --publish never",
    "dist:x64": "pnpm build && node scripts/collect-binaries.mjs --x64 && electron-builder --mac --x64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@lirovo/contracts": "workspace:*",
    "@lirovo/core": "workspace:*",
    "@lirovo/node-runtime": "workspace:*",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "framer-motion": "^12.0.0",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "js-yaml": "^5.4.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "description": "Local-first structured extraction for video.",
  "author": {
    "name": "Lirovo"
  }
}
