{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // electron augments NodeJS.Process with parentPort for utilityProcess.
    "types": ["node", "vite/client", "electron"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
